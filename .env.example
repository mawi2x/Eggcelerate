# Local development names only; real values stay out of git.
# For a team preview, switch VITE_DATA_SOURCE to api, use the same-origin
# /api route, and enable the database profile as shown below.
APP_ENV=development
AUTH_MODE=disabled
DEFAULT_FARM_ID=00000000-0000-0000-0000-000000000001
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
STORAGE_BACKEND=memory
# Compose API: set STORAGE_BACKEND=postgres_incubators and DATABASE_URL for
# restart-surviving farm configuration, telemetry and commands.
# DATABASE_URL=postgresql+asyncpg://eggcelerate:eggcelerate_local@db:5432/eggcelerate
# Host CLI uses 127.0.0.1 instead of db. Local development credential only.
POSTGRES_PASSWORD=eggcelerate_local
# Used by the MQTT worker. compose.simulator.yaml sets MQTT_HOST=broker internally.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Optional broker credentials; the bundled local broker is anonymous.
# MQTT_USERNAME=
# MQTT_PASSWORD=
SIMULATOR_DISPATCH_ENABLED=false
# Optional disposable integration-test database; never point this at development data.
# TEST_DATABASE_URL=postgresql+asyncpg://eggcelerate:eggcelerate_test@127.0.0.1:55432/eggcelerate_test
# Build-time web switch: false disables periodic incubator polling but keeps UI status ageing.
VITE_LIVE_REFRESH_ENABLED=true
VITE_DATA_SOURCE=mock
# The mock repository ignores this value; /api is the VPS same-origin route.
VITE_API_URL=/api
# Team preview build (the API is still intentionally auth-disabled until B6):
# VITE_DATA_SOURCE=api
